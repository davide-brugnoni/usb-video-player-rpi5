[Unit]
Description=USB Video Player (riproduzione automatica video da chiavetta)
After=multi-user.target local-fs.target
Wants=multi-user.target

# Opzionale: decommenta se il prompt di login sulla console dà fastidio.
# Ferma il login locale su tty1 (l'accesso via SSH resta disponibile).
#Conflicts=getty@tty1.service
#After=getty@tty1.service

[Service]
Type=simple
ExecStart=/usr/local/bin/usb-video-player.sh
Restart=always
RestartSec=5
User=root

# la console resta pulita e senza cursore
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=no

# il player deve poter diventare DRM master
Environment=DISPLAY=
Environment=WAYLAND_DISPLAY=

[Install]
WantedBy=multi-user.target
